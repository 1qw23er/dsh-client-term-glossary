{
  "name": "dsh-client-term-glossary",
  "version": "1.1.0",
  "description": "DSH 划词即解释插件：选中术语/报错/命令即弹大白话解释浮层，含 139 条本地词典、英文在线词典、语音朗读、深色模式适配、自定义词条，旁路进行不打扰主任务",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "glossary",
    "dictionary",
    "selection",
    "term",
    "explain",
    "chinese",
    "tooltip",
    "popover",
    "tts",
    "text-to-speech"
  ],
  "author": "黎叔AI创业实验室",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1qw23er/dsh-client-term-glossary.git"
  },
  "homepage": "https://github.com/1qw23er/dsh-client-term-glossary#readme",
  "bugs": {
    "url": "https://github.com/1qw23er/dsh-client-term-glossary/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  }
}
